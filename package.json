{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "collector:setup": "npm --prefix integrations/socialmonitor install",
    "collector:browser": "npm --prefix integrations/socialmonitor exec -- playwright install chromium",
    "collector:login": "node integrations/socialmonitor/worker.mjs login",
    "collector:test": "node --test integrations/socialmonitor/worker.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:analysis": "node --test tests/analysis-panels.test.mjs tests/insight-panels.test.mjs",
    "test:hosting": "node --test tests/hosting.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.76.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
