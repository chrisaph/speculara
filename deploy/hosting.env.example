# Copy to deploy/.env on the VPS. Do not commit real values.
DOMAIN=speculara.example.com
SITE_USER=demo
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
# Preserve the surrounding single quotes when pasting the hash.
SITE_PASSWORD_HASH='replace-with-generated-bcrypt-hash'
GEMMA_API_KEY=replace-with-your-server-key
GEMMA_MODEL=gemma-4-31b-it
# Keep disabled except during operator sign-in over an SSH tunnel.
ENABLE_REMOTE_DESKTOP=0
# Optional saved history:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
